exports[`LineBreakRepairModal (characterization) > reports a save that fails half way > error 1`] = `"<div><div class="modal-backdrop"><section aria-labelledby="linebreak-title" aria-modal="true" class="modal linebreak-modal" role="dialog"><p class="eyebrow">Texto colado de PDF</p><h2 id="linebreak-title">Juntar linhas quebradas</h2><p>Procura quebras de linha no meio de frases: a linha anterior não termina a frase e a seguinte continua em minúscula. Confira a lista, desmarque o que deve ficar como está (poemas, cartas, trechos com formatação especial) e só então junte. Diálogos e parágrafos novos não entram.</p><p class="form-message">Falhou 1 cena já foi salva.</p><div class="modal-actions"><button class="button button-secondary" type="button">Cancelar</button></div></section></div></div>"`;

exports[`LineBreakRepairModal (characterization) > says when there is nothing to join 1`] = `"<div><div class="modal-backdrop"><section aria-labelledby="linebreak-title" aria-modal="true" class="modal linebreak-modal" role="dialog"><p class="eyebrow">Texto colado de PDF</p><h2 id="linebreak-title">Juntar linhas quebradas</h2><p>Procura quebras de linha no meio de frases: a linha anterior não termina a frase e a seguinte continua em minúscula. Confira a lista, desmarque o que deve ficar como está (poemas, cartas, trechos com formatação especial) e só então junte. Diálogos e parágrafos novos não entram.</p><p class="linebreak-done">Nenhuma quebra no meio de frase encontrada neste projeto.</p><div class="modal-actions"><button class="button button-secondary" type="button">Cancelar</button></div></section></div></div>"`;
